import { getAdmin } from "@/src/lib/auth";
import { NextResponse } from "next/server";
import PDFDocument from "pdfkit";
import db from "@/src/lib/db";

export async function GET(
  request: Request,
  { params }: { params: Promise<{ id:string }> }
) {

  const { id } = await params;

  const [rows]: any = await db.query(
    `
    SELECT
      i.*,
      o.order_number,
      o.server_plan,
      o.location
    FROM invoices i
    LEFT JOIN orders o
      ON o.id=i.order_id
    WHERE i.id=?
      AND i.customer_id=?
    LIMIT 1
    `,
    [id, admin.id]
  );

  if (!rows.length) {
    return NextResponse.json(
      { error: "Invoice not found" },
      { status: 404 }
    );
  }

  const invoice = rows[0];

  const doc = new PDFDocument({
    margin: 50
  });

  const chunks: Buffer[] = [];

  doc.on("data", (chunk) => chunks.push(chunk));

  const pdfPromise = new Promise<Buffer>((resolve) => {
    doc.on("end", () => {
      resolve(Buffer.concat(chunks));
    });
  });

  doc.fontSize(24).text("1PBPS", {
    align: "left"
  });

  doc.fontSize(12).text("Dedicated Servers & Cloud Infrastructure");

  doc.moveDown();

  doc.fontSize(20).text("INVOICE", {
    align: "right"
  });

  doc.moveDown();

  doc.fontSize(12).text(`Invoice #: ${invoice.invoice_no}`);
  doc.text(`Status: ${invoice.status}`);
  doc.text(`Created: ${String(invoice.created_at).slice(0,10)}`);
  doc.text(`Due Date: ${String(invoice.due_date).slice(0,10)}`);

  doc.moveDown();

  doc.fontSize(16).text("Bill To");

  doc.fontSize(12).text(invoice.billing_name || "-");
  doc.text(invoice.billing_address || "-");
  doc.text(`GST: ${invoice.gst_number || "-"}`);

  doc.moveDown();

  doc.fontSize(16).text("Service");

  doc.fontSize(12).text(`Order: ${invoice.order_number || "-"}`);
  doc.text(`Plan: ${invoice.server_plan || "-"}`);
  doc.text(`Location: ${invoice.location || "-"}`);

  doc.moveDown();

  doc.fontSize(16).text("Amount Breakdown");

  doc.fontSize(12).text(`Subtotal: $${invoice.subtotal}`);
  doc.text(`Discount: $${invoice.discount}`);
  doc.text(`GST (${invoice.gst_percent}%): $${invoice.gst_amount}`);

  doc.moveDown();

  doc.fontSize(18).text(
    `Total: $${invoice.total}`,
    {
      align: "right"
    }
  );

  doc.end();

  const pdf = await pdfPromise;

  return new NextResponse(new Uint8Array(pdf), {
    headers: {
      "Content-Type": "application/pdf",
      "Content-Disposition":
        `attachment; filename="${invoice.invoice_no}.pdf"`
    }
  });
}
