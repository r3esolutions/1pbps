import { NextResponse } from "next/server";
import db from "@/src/lib/db";

export async function POST(req: Request) {
  try {

    const body = await req.json();

    console.log("ORDER DATA:", body);

    const [customer]: any = await db.query(
      `INSERT INTO customers
      (full_name, company_name, email, phone, country)
      VALUES (?, ?, ?, ?, ?)`,
      [
        body.full_name,
        body.company_name,
        body.email,
        body.phone,
        body.country
      ]
    );

    const customerId = customer.insertId;

    const [order]: any = await db.query(
      `INSERT INTO orders
      (
        customer_id,
        location,
        server_plan,
        ram,
        storage,
        operating_system,
        ipv4_qty,
        bandwidth,
        billing_term,
        payment_method,
        subtotal,
        discount,
        total
      )
      VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)`,
      [
        customerId,
        body.location,
        body.server_plan,
        body.ram,
        body.storage,
        body.operating_system,
        body.ipv4_qty,
        body.bandwidth,
        body.billing_term,
        body.payment_method,
        body.subtotal,
        body.discount,
        body.total
      ]
    );

    return NextResponse.json({
      success:true,
      customer_id:customerId,
      order_id:order.insertId
    });

  } catch(error:any) {

    console.error("FULL ERROR =>", error);

    return NextResponse.json({
      success:false,
      error:error.message
    });
  }
}
