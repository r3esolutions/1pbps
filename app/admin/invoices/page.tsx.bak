import db from "@/src/lib/db";

export default async function InvoicesPage() {
  const [invoices]: any = await db.query(`
    SELECT
      i.id,
      i.invoice_no,
      i.total,
      i.status,
      c.email
    FROM invoices i
    LEFT JOIN customers c
      ON c.id = i.customer_id
    ORDER BY i.id DESC
  `);

  return (
    <div>
      <h1 className="text-4xl font-bold text-white">
        Invoices
      </h1>

      <div className="mt-8 overflow-auto">
        <table className="w-full">
          <thead>
            <tr>
              <th>ID</th>
              <th>Invoice</th>
              <th>Customer</th>
              <th>Total</th>
              <th>Status</th>
            </tr>
          </thead>

          <tbody>
            {invoices.map((i:any)=>(
              <tr key={i.id}>
                <td>{i.id}</td>
                <td>{i.invoice_no}</td>
                <td>{i.email}</td>
                <td>₹{i.total}</td>
                <td>{i.status}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  );
}
