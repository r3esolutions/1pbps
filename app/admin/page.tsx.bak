import db from "@/src/lib/db";

export default async function AdminDashboard() {

  const [customers]: any =
    await db.query(
      "SELECT COUNT(*) total FROM customers"
    );

  const [orders]: any =
    await db.query(
      "SELECT COUNT(*) total FROM orders"
    );

  const [tickets]: any =
    await db.query(
      "SELECT COUNT(*) total FROM tickets"
    );

  const [leads]: any =
    await db.query(
      "SELECT COUNT(*) total FROM leads"
    );

  return (
    <div className="p-8">

      <h1 className="text-4xl font-bold text-white">
        Admin Dashboard
      </h1>

      <div className="grid md:grid-cols-4 gap-6 mt-8">

        <div className="rounded-2xl border border-white/10 p-6">
          <div>Customers</div>
          <div className="text-4xl font-bold">
            {customers[0].total}
          </div>
        </div>

        <div className="rounded-2xl border border-white/10 p-6">
          <div>Orders</div>
          <div className="text-4xl font-bold">
            {orders[0].total}
          </div>
        </div>

        <div className="rounded-2xl border border-white/10 p-6">
          <div>Tickets</div>
          <div className="text-4xl font-bold">
            {tickets[0].total}
          </div>
        </div>

        <div className="rounded-2xl border border-white/10 p-6">
          <div>Leads</div>
          <div className="text-4xl font-bold">
            {leads[0].total}
          </div>
        </div>

      </div>

    </div>
  );
}
