import db from "@/src/lib/db";

export default async function OrdersPage() {
  const [orders]: any = await db.query(`
    SELECT
      o.id,
      o.location,
      o.server_plan,
      o.total,
      c.email,
      c.company_name
    FROM orders o
    LEFT JOIN customers c
      ON c.id = o.customer_id
    ORDER BY o.id DESC
  `);

  return (
    <div>
      <h1 className="text-4xl font-bold text-white">
        Orders
      </h1>

      <div className="mt-8 overflow-auto">
        <table className="w-full">
          <thead>
            <tr>
              <th>ID</th>
              <th>Customer</th>
              <th>Location</th>
              <th>Plan</th>
              <th>Total</th>
            </tr>
          </thead>

          <tbody>
            {orders.map((o:any)=>(
              <tr key={o.id}>
                <td>{o.id}</td>
                <td>{o.email}</td>
                <td>{o.location}</td>
                <td>{o.server_plan}</td>
                <td>${o.total}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  );
}
