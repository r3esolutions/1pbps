import db from "@/src/lib/db";

export default async function OrdersPage() {
  const [orders]: any = await db.query(`
    SELECT
      o.id,
      o.order_number,
      o.location,
      o.server_plan,
      o.total,
      o.payment_status,
      o.provisioning_status,
      o.txid,
      c.email,
      c.full_name,
      c.company_name
    FROM orders o
    LEFT JOIN customers c
      ON c.id = o.customer_id
    ORDER BY o.id DESC
  `);

  return (
    <div>
      <h1 className="text-4xl font-bold text-white">
        Orders
      </h1>

      <div className="mt-8 overflow-auto">
        <table className="w-full text-white">
          <thead>
            <tr>
              <th>ID</th>
              <th>Order #</th>
              <th>Customer</th>
              <th>Email</th>
              <th>Location</th>
              <th>Plan</th>
              <th>Total</th>
              <th>Payment</th>
              <th>Provisioning</th>
              <th>TXID</th>
            </tr>
          </thead>

          <tbody>
            {orders.map((o:any)=>(
              <tr key={o.id}>
                <td>{o.id}</td>
                <td>{o.order_number}</td>
                <td>{o.full_name}</td>
                <td>{o.email}</td>
                <td>{o.location}</td>
                <td>{o.server_plan}</td>
                <td>${o.total}</td>
                <td>{o.payment_status}</td>
                <td>{o.provisioning_status}</td>
                <td className="max-w-xs break-all">
                  {o.txid || "-"}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  );
}
